{
  "name": "asma-ul-husna-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Asma'ul Husna — the 99 Names of Allah, Quran reader, memorization and kids' activities. Fully offline phone app.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test",
    "data": "node scripts/build-data.mjs",
    "logo": "node scripts/build-logo.mjs",
    "icons": "node scripts/make-icons.mjs && capacitor-assets generate --android",
    "android:sync": "vite build && cap sync android",
    "android:open": "cap open android",
    "apk": "vite build && cap sync android && cd android && gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/amiri": "^5.3.0",
    "@fontsource/amiri-quran": "^5.3.0",
    "@fontsource/aref-ruqaa": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/tajawal": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
